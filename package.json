{
  "name": "dsh-plan-usage",
  "version": "0.3.0",
  "type": "module",
  "description": "A usage panel for provider plans: shows how much of each quota window is left (GLM Coding Plan and OpenCode Zen) as a compact chip next to the model selector, with a detail popover.",
  "keywords": [
    "dsh-plugin",
    "deepseek",
    "harness",
    "usage",
    "quota",
    "panel",
    "opencode",
    "glm"
  ],
  "author": "Dogtiti",
  "license": "MIT",
  "homepage": "https://github.com/Dogtiti/dsh-plan-usage#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dogtiti/dsh-plan-usage"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "dsh": "^0.2.1-0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "bugs": {
    "url": "https://github.com/Dogtiti/dsh-plan-usage/issues"
  }
}
